{
  "name": "bbibinbings",
  "private": true,
  "version": "0.2.3",
  "author": "混世魔王",
  "packageManager": "pnpm@10.6.5",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "cleanAndPrune": "node ./scripts/package-manager.mjs clean-and-prune",
    "bootstrap": "node ./scripts/package-manager.mjs install",
    "plop": "plop",
    "dev": "vite --mode development",
    "dev:host": "vite --mode development --host",
    "build": "vite build",
    "build:analyze": "cross-env ANALYSIS=true vite build",
    "preview": "vite preview",
    "build:dev": "vite build --mode development",
    "build:pro": "vite build --mode production",
    "serve": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "pnpm lint:eslint && pnpm lint:stylelint",
    "format": "pnpm lint:prettier",
    "lint:eslint": "eslint --cache --max-warnings 0 \"{src,mock}/**/*.{vue,ts,tsx}\" --fix",
    "lint:prettier": "prettier --write  \"src/**/*.{js,json,tsx,css,less,scss,vue,html,md}\"",
    "lint:stylelint": "stylelint --cache --fix \"**/*.{vue,less,postcss,css,scss}\" --cache --cache-location node_modules/.cache/stylelint/",
    "lint:lint-staged": "lint-staged",
    "prepare": "husky install",
    "deps": "pnpm update --interactive --latest"
  },
  "dependencies": {
    "@vueuse/components": "^14.2.1",
    "@vueuse/core": "^14.2.1",
    "axios": "^0.27.2",
    "mockjs": "^1.1.0",
    "ol": "^10.8.0",
    "pinia": "^2.3.1",
    "plop": "^3.1.0",
    "qs": "^6.10.5",
    "vue": "^3.5.31",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.39.4",
    "@types/node": "^20.19.37",
    "@types/nprogress": "^0.2.0",
    "@types/qs": "^6.9.7",
    "@typescript-eslint/eslint-plugin": "8.46.4",
    "@typescript-eslint/parser": "8.46.4",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitejs/plugin-vue-jsx": "^4.2.0",
    "autoprefixer": "^10.4.7",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^17.4.0",
    "husky": "^8.0.1",
    "import": "^0.0.6",
    "less": "^4.1.3",
    "lint-staged": "^15.5.2",
    "naive-ui": "^2.44.1",
    "nprogress": "^0.2.0",
    "postcss": "^8.4.14",
    "postcss-html": "^1.4.1",
    "postcss-less": "^6.0.0",
    "postcss-px-to-viewport-8-plugin": "^1.2.5",
    "prettier": "^3.8.1",
    "rollup-plugin-visualizer": "^6.0.11",
    "stylelint": "^16.26.1",
    "stylelint-config-recommended": "^17.0.0",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard": "^39.0.1",
    "stylelint-order": "^6.0.4",
    "typescript": "^5.9.3",
    "unplugin-auto-import": "^19.3.0",
    "unplugin-vue-components": "^28.8.0",
    "vite": "^6.4.1",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-html": "^3.2.0",
    "vite-plugin-mock": "^3.0.2",
    "vite-plugin-pages": "^0.33.3",
    "vite-plugin-progress": "^0.0.7",
    "vite-plugin-restart": "^2.0.0",
    "vite-plugin-svg-icons": "^2.0.1",
    "vite-plugin-vue-layouts": "^0.11.0",
    "vite-plugin-windicss": "^1.8.4",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.2.12"
  },
  "lint-staged": {
    "{src,mock}/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "{!(package)*.json,*.code-snippets,.!(browserslist)*rc}": [
      "prettier --write --parser json"
    ],
    "package.json": [
      "prettier --write"
    ],
    "src/**/*.vue": [
      "eslint --fix",
      "prettier --write",
      "stylelint --fix"
    ],
    "src/**/*.{scss,less,styl,html}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.md": [
      "prettier --write"
    ]
  }
}
